# NPM Shield AI Environment Configuration Example

# Application Settings
APP_NAME="NPM Shield AI"
APP_VERSION="1.0.0"
DEBUG=True

# Database Configuration
DATABASE_URL="sqlite:///npm_shield.db"

# External Registry & Vulnerability APIs
NPM_REGISTRY_URL="https://registry.npmjs.org"
OSV_API_URL="https://api.osv.dev/v1/query"
REQUEST_TIMEOUT=20

# Optional AI / LLM Configuration
# Set LLM_PROVIDER to "gemini", "openai", or "deterministic" (default)
LLM_PROVIDER="deterministic"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Demo Mode (Enable deterministic simulation scans for offline/demo use)
DEMO_MODE_ENABLED=True

# Dynamic Sandbox Execution (Disabled by default for host security)
ENABLE_DYNAMIC_ANALYSIS=False
